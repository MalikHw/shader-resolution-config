{
    "geode": "5.7.0",
    "gd": {
        "win": "2.2081",
        "mac": "2.2081",
        "android": "2.2081",
        "ios": "2.2081"
    },
    "version": "1.0.0",
    "id": "malikhw47.shader-resolution-config",
    "name": "shader resolution config",
    "developer": "MalikHw47",
    "description": "Reduce shader rendering resolution for better performance on lower-end devices",
    "tags": ["gameplay", "performance"],
    "links": {
        "source": "https://github.com/MalikHw/shader-resolution-config",
        "community": "https://discord.gg/G9bZ92eg2n"
    },
    "settings": {
        "resolution-multiplier": {
            "name": "Resolution multiplier",
            "description": "multiplier for shader resolution",
            "type": "float",
            "default": 1.0,
            "min": 0.1,
            "max": 1.0,
            "control": {
                "slider": true,
                "arrows": false,
                "big-arrows": false,
                "arrow-step": 0.05,
                "big-arrow-step": 0.1,
                "slider-step": 0.05
            }
        }
    }
}
